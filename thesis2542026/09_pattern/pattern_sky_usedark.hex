// use_dark flag (1-bit binary)
0  // [00] Black - gray=0 < A0
0  // [01] gray=149, just below A0
0  // [02] gray=150, equal A0 (not >)
0  // [03] gray=151, just above A0 => sky
0  // [04] White - gray=255 >> A0 => sky
0  // [05] Dark pixel - non-sky
0  // [06] Medium dark - non-sky
0  // [07] Bright - sky
0  // [08] Very bright - sky
0  // [09] Mid gray - non-sky
1  // [10] dark_ch=0 << A0 - non-sky
1  // [11] dark_ch=149, just below A0
1  // [12] dark_ch=150, equal A0 (not >)
1  // [13] dark_ch=151, just above => sky
1  // [14] dark_ch=255 >> A0 => sky
1  // [15] dark_ch=80 - non-sky
1  // [16] dark_ch=130 - non-sky
1  // [17] dark_ch=180 - sky
1  // [18] dark_ch=200 - sky
1  // [19] dark_ch=100 - non-sky
