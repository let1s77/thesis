// RGB Pattern Input (24-bit: [23:16]=B, [15:8]=G, [7:0]=R)
FFFFFF  // [00] R=255, G=255, B=255 - White
000000  // [01] R=  0, G=  0, B=  0 - Black
0000FF  // [02] R=255, G=  0, B=  0 - Pure Red
00FF00  // [03] R=  0, G=255, B=  0 - Pure Green
FF0000  // [04] R=  0, G=  0, B=255 - Pure Blue
808080  // [05] R=128, G=128, B=128 - Gray 50%
404040  // [06] R= 64, G= 64, B= 64 - Gray 25%
C0C0C0  // [07] R=192, G=192, B=192 - Gray 75%
4080FF  // [08] R=255, G=128, B= 64 - Warm tone
FF8040  // [09] R= 64, G=128, B=255 - Cool tone
74F0F0  // [10] R=240, G=240, B=116 - Light hazy
62CC61  // [11] R= 97, G=204, B= 98 - Green vegetation
1047B5  // [12] R=181, G= 71, B= 16 - Brown/orange
9AF48E  // [13] R=142, G=244, B=154 - Teal
7CD0E2  // [14] R=226, G=208, B=124 - Sunset
646464  // [15] R=100, G=100, B=100 - Mid gray
