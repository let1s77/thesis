// RGB Pattern Input + Dark Channel for Atmospheric Light Estimation
// Format: Each line = BBGGRR_DD (24-bit RGB + 8-bit Dark Channel)
// [31:24]=Dark, [23:16]=Blue, [15:8]=Green, [7:0]=Red
//
FFFFFFFF  // Pattern 1: RGB=(255,255,255), Dark=255 - Pure white - Maximum haze
F0FAF5F0  // Pattern 2: RGB=(240,245,250), Dark=240 - Very bright sky - Heavy haze
DCEBE6DC  // Pattern 3: RGB=(220,230,235), Dark=220 - Bright hazy sky
C8D7D2C8  // Pattern 4: RGB=(200,210,215), Dark=200 - Medium hazy atmosphere
B4C3BEB4  // Pattern 5: RGB=(180,190,195), Dark=180 - Light haze
A0AFAAA0  // Pattern 6: RGB=(160,170,175), Dark=160 - Slight atmospheric haze
808C8780  // Pattern 7: RGB=(128,135,140), Dark=128 - Gray haze
64736E64  // Pattern 8: RGB=(100,110,115), Dark=100 - Weak haze
505F5A50  // Pattern 9: RGB=( 80, 90, 95), Dark= 80 - Very weak haze
3C4B463C  // Pattern 10: RGB=( 60, 70, 75), Dark= 60 - Minimal haze
B4B4C8FF  // Pattern 11: RGB=(255,200,180), Dark=180 - Warm atmospheric light
B4FFC8B4  // Pattern 12: RGB=(180,200,255), Dark=180 - Cool atmospheric light
C8C8DCFF  // Pattern 13: RGB=(255,220,200), Dark=200 - Sunset atmospheric light
C8FFDCC8  // Pattern 14: RGB=(200,220,255), Dark=200 - Sky atmospheric light
00000000  // Pattern 15: RGB=(  0,  0,  0), Dark=  0 - Black - No atmospheric light
000000FF  // Pattern 16: RGB=(255,  0,  0), Dark=  0 - Pure red - Red atmospheric light
0000FF00  // Pattern 17: RGB=(  0,255,  0), Dark=  0 - Pure green - Green atmospheric light
00FF0000  // Pattern 18: RGB=(  0,  0,255), Dark=  0 - Pure blue - Blue atmospheric light
96A5A096  // Pattern 19: RGB=(150,160,165), Dark=150 - Typical hazy day
BED2C8BE  // Pattern 20: RGB=(190,200,210), Dark=190 - Dense fog/haze
