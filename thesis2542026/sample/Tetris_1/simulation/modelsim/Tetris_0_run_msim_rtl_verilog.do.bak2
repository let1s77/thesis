transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+C:/D/Study_material/(DATN)/Tetris_1/00_src/grid {C:/D/Study_material/(DATN)/Tetris_1/00_src/grid/grid.v}
