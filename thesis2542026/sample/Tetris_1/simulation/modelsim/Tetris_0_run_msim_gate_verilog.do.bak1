transcript on
if {[file exists gate_work]} {
	vdel -lib gate_work -all
}
vlib gate_work
vmap work gate_work

vlog -vlog01compat -work work +incdir+. {Tetris_0.vo}

vlog -sv -work work +incdir+C:/D/Study_material/(DATN)/Tetris_1/01_tb {C:/D/Study_material/(DATN)/Tetris_1/01_tb/tb_1.sv}

vsim -t 1ps -L altera_ver -L cycloneive_ver -L gate_work -L work -voptargs="+acc"  tb_1

add wave *
view structure
view signals
run -all
