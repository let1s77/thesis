// Golden Atmospheric Light Output (24-bit: [23:16]=A_B, [15:8]=A_G, [7:0]=A_R)

// [00] RGB=(255,255,255), D=255 - Pure white - Max haze
FFFFFF  // A=(255,255,255)

// [01] RGB=(240,245,250), D=240 - Very bright sky
FAF5F0  // A=(240,245,250)

// [02] RGB=(220,230,235), D=220 - Bright hazy sky
EBE6DC  // A=(220,230,235)

// [03] RGB=(200,210,215), D=200 - Medium hazy
D7D2C8  // A=(200,210,215)

// [04] RGB=(180,190,195), D=180 - Light haze
C3BEB4  // A=(180,190,195)

// [05] RGB=(160,170,175), D=160 - Slight haze
AFAAA0  // A=(160,170,175)

// [06] RGB=(128,135,140), D=128 - Gray haze
8C8780  // A=(128,135,140)

// [07] RGB=(100,110,115), D=100 - Weak haze
736E64  // A=(100,110,115)

// [08] RGB=( 80, 90, 95), D= 80 - Very weak haze
5F5A50  // A=( 80, 90, 95)

// [09] RGB=( 60, 70, 75), D= 60 - Minimal haze
4B463C  // A=( 60, 70, 75)

// [10] RGB=(255,200,180), D=180 - Warm atmospheric
B4C8FF  // A=(255,200,180)

// [11] RGB=(180,200,255), D=180 - Cool atmospheric
FFC8B4  // A=(180,200,255)

// [12] RGB=(255,220,200), D=200 - Sunset light
C8DCFF  // A=(255,220,200)

// [13] RGB=(200,220,255), D=200 - Sky light
FFDCC8  // A=(200,220,255)

// [14] RGB=(  0,  0,  0), D=  0 - Black - No light
000000  // A=(  0,  0,  0)

// [15] RGB=(255,  0,  0), D=  0 - Pure red
0000FF  // A=(255,  0,  0)

// [16] RGB=(  0,255,  0), D=  0 - Pure green
00FF00  // A=(  0,255,  0)

// [17] RGB=(  0,  0,255), D=  0 - Pure blue
FF0000  // A=(  0,  0,255)

// [18] RGB=(150,160,165), D=150 - Typical hazy day
A5A096  // A=(150,160,165)

// [19] RGB=(190,200,210), D=190 - Dense fog
D2C8BE  // A=(190,200,210)

